rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isLoggedIn() {
      return request.auth != null;
    }

    // Users
    match /users/{userId} {
      allow read, write: if isLoggedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow create: if isLoggedIn();
      allow read: if isLoggedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Menu
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tables (QR)
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Loyalty Cards
    match /loyaltyCards/{cardId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // Promo Codes
    match /promoCodes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── NEW COLLECTIONS ──────────────────────────────────────────────

    // Inventory
    match /inventory/{itemId} {
      allow read, write: if isAdmin();
    }

    // Stock Updates log
    match /stockUpdates/{id} {
      allow read, write: if isAdmin();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    // Supplier Payments
    match /supplierPayments/{payId} {
      allow read, write: if isAdmin();
    }

    // Stock Purchases (legacy)
    match /stockPurchases/{purchaseId} {
      allow read, write: if isAdmin();
    }

    // Expenses
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // Staff
    match /staff/{staffId} {
      allow read, write: if isAdmin();
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read, write: if isAdmin();
    }

    // Settings
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics
    match /analytics/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
