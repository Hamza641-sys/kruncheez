rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isLoggedIn() {
      return request.auth != null;
    }

    // Users — own data only, admin can read/write all
    match /users/{userId} {
      allow read, write: if isLoggedIn() && request.auth.uid == userId;
      allow read, write: if isAdmin();
    }

    // Orders — customer creates, admin manages all
    match /orders/{orderId} {
      allow create: if isLoggedIn();
      allow read: if isLoggedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Menu — anyone reads, admin writes
    match /menu/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tables (QR system) — admin full access, anyone can read
    match /tables/{tableId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Loyalty Cards — customer reads own, admin manages all
    match /loyaltyCards/{cardId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update: if isLoggedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Reviews — anyone reads, authenticated creates, admin manages
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isLoggedIn();
      allow update, delete: if isAdmin();
    }

    // Promo Codes — anyone reads, admin manages
    match /promoCodes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Analytics — admin only
    match /analytics/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
